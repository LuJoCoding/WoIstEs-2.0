      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ort speichern"
          }
        }
      }
    },
    "Saves where an item is now. The previous location is replaced.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert, wo ein Gegenstand jetzt liegt. Der alte Ort wird ersetzt."
